# Environment variables and secrets
.env
.env.*
!.env.example
**/config.json

# Private credentials
*.pem
*.key
*.p12
*.pfx

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Forensic evidence
**/evidence/
**/*.shutdown_signal

# Local databases and logs
*.db
*.sqlite3
*.log

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Terraform local files and sensitive state
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json
**/*.tfplan

# Allow safe example variable files
!**/*.tfvars.example